{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "tsconfig.json",
    "watchAssets": true,
    "assets": [
      {
        "include": "**/*.{html,css,jade,pug}",
        "outDir": "dist/public",
        "watchAssets": true
      },
      {
        "include": "public/**/*",
        "outDir": "dist",
        "watchAssets": true
      },
      {
        "include": "views/**/*",
        "outDir": "dist",
        "watchAssets": true
      },
      {
        "include": "utils/**/*.txt",
        "outDir": "dist/utils",
        "watchAssets": true
      }
    ],
    "plugins": [
      {
        "name": "@nestjs/swagger/plugin",
        "options": {
          "classValidatorShim": true,
          "introspectComments": true
        }
      }
    ]
  },
  "generateOptions": {
    "spec": false
  },
  "projects": {}
}