    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.2",
    "@types/body-parser": "^1.19.3",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/crypto-js": "^4.1.2",
    "@types/debug": "^4.1.8",
